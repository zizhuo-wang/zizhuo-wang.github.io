---
import Intro from '../components/Intro.astro';
import ProjectItem from '../components/ProjectItem.astro';
import ResearchExperienceList from '../components/ResearchExperienceList.astro';
import { projects } from '../data/projects';
import { researchExperienceItems } from '../data/researchExperience';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<Intro />

	<section
		class="publications-section"
		id="publications"
		aria-labelledby="publications-heading"
	>
		<div class="page-container">
			<header class="section-header">
				<h2 id="publications-heading">Publications</h2>
			</header>

			<div class="academic-list">
				{projects.map((project) => <ProjectItem project={project} />)}
			</div>
		</div>
	</section>

	<ResearchExperienceList items={researchExperienceItems} />
</BaseLayout>

<style>
	.publications-section {
		padding-block: clamp(3.5rem, 7vw, 6rem);
	}

	.section-header {
		margin-bottom: 1.35rem;
	}

	.section-header h2 {
		position: relative;
		width: fit-content;
		margin: 0;
		font-size: var(--font-size-section-title);
		font-weight: 680;
		line-height: 1.25;
	}

	.section-header h2::after {
		display: block;
		width: 2rem;
		height: 2px;
		margin-top: 0.45rem;
		background: var(--color-link);
		content: '';
	}

	.academic-list {
		display: grid;
		gap: 0.9rem;
	}
</style>
