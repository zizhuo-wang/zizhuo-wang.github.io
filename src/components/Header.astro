---
const homeHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const photographyHref = `${homeHref}photography/`;
const isPhotographyPage =
	Astro.url.pathname.replace(/\/$/, '') === photographyHref.replace(/\/$/, '');

const navigation = [
	{ label: 'Publications', href: `${homeHref}#publications` },
	{ label: 'Experience', href: `${homeHref}#research-experience` },
	{ label: 'Photography', href: photographyHref },
];
---

<header class="site-header">
	<div class="page-container header-inner">
		<a class="site-name" href={`${homeHref}#top`} aria-label="Homepage, return to top">
			Homepage
		</a>

		<nav class="primary-navigation" aria-label="Primary navigation">
			<ul>
				{
					navigation.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={isPhotographyPage && item.href === photographyHref ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
				<li>
					<span class="pending-link" aria-disabled="true">
						CV<span class="visually-hidden"> (forthcoming)</span>
					</span>
				</li>
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid var(--color-border);
		background: var(--color-background);
	}

	.header-inner {
		--header-navigation-gap: clamp(1rem, 2.5vw, 1.75rem);

		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: var(--header-navigation-gap);
		min-height: 3.5rem;
		padding-block: 0.65rem;
	}

	.site-name {
		flex: none;
		width: fit-content;
		color: var(--color-text);
		font-size: 1rem;
		font-weight: 680;
		text-decoration: none;
		white-space: nowrap;
	}

	.primary-navigation {
		position: relative;
		flex: 0 1 auto;
		min-width: 0;
		margin-inline: -0.35rem;
		overflow-x: auto;
		scroll-behavior: auto;
		scroll-padding-inline: 0.35rem;
		scroll-snap-type: x mandatory;
		overscroll-behavior-inline: contain;
		scrollbar-width: none;
	}

	.primary-navigation::-webkit-scrollbar {
		display: none;
	}

	.primary-navigation ul {
		display: flex;
		justify-content: flex-start;
		gap: var(--header-navigation-gap);
		width: max-content;
		margin: 0;
		padding: 0.35rem;
		list-style: none;
	}

	.primary-navigation a,
	.pending-link {
		display: inline-block;
		padding-block: 0.2rem;
		font-size: 0.875rem;
		line-height: 1.4;
		white-space: nowrap;
	}

	.primary-navigation a {
		scroll-margin-inline: 0.35rem;
		color: var(--color-text);
		text-decoration: none;
	}

	.primary-navigation a:focus-visible {
		/* Reveal partially clipped keyboard targets without changing touch scrolling. */
		scroll-snap-align: center;
	}

	.primary-navigation a:hover,
	.primary-navigation a:focus-visible,
	.primary-navigation a[aria-current='page'] {
		color: var(--color-link);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
	}

	.pending-link {
		color: var(--color-text-muted);
		cursor: default;
	}

	@media (min-width: 40rem) {
		.header-inner {
			min-height: 3.75rem;
			padding-block: 0.75rem;
		}

		.primary-navigation ul {
			min-width: 0;
		}
	}
</style>
