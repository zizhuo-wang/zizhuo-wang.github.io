---
import type { ResearchExperienceItem } from '../data/researchExperience';

interface Props {
	items: ResearchExperienceItem[];
}

const { items } = Astro.props;
---

<section
	class="content-section"
	id="research-experience"
	aria-labelledby="research-experience-heading"
>
	<div class="page-container">
		<h2 id="research-experience-heading">Research Experience</h2>
		<ol class="experience-list">
			{
				items.map((item) => (
					<li data-placeholder={item.placeholder ? 'true' : undefined}>
						<p class="period">{item.period}</p>
						<div>
							<h3>{item.title}</h3>
							<p class="institution">{item.institution}</p>
							{item.detail && <p class="detail">{item.detail}</p>}
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	h2 {
		position: relative;
		width: fit-content;
		margin: 0 0 1rem;
		font-size: var(--font-size-section-title);
		font-weight: 680;
		line-height: 1.25;
	}

	h2::after {
		display: block;
		width: 2rem;
		height: 2px;
		margin-top: 0.45rem;
		background: var(--color-link);
		content: '';
	}

	.experience-list {
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-border);
		list-style: none;
	}

	.experience-list li {
		display: grid;
		grid-template-columns: 4.75rem minmax(0, 1fr);
		gap: 0.75rem;
		padding-block: 0.85rem;
		border-bottom: 1px solid var(--color-border);
	}

	.experience-list p,
	.experience-list h3 {
		margin: 0;
	}

	.period,
	.institution,
	.detail {
		color: var(--color-text-muted);
	}

	.period {
		font-size: 0.8rem;
		font-variant-numeric: tabular-nums;
	}

	h3 {
		font-size: 0.98rem;
		font-weight: 650;
		line-height: 1.4;
	}

	.institution,
	.detail {
		margin-top: 0.15rem !important;
		font-size: 0.86rem;
		line-height: 1.45;
	}

	@media (min-width: 40rem) {
		.experience-list li {
			grid-template-columns: 7rem minmax(0, 1fr);
			gap: 1.5rem;
		}
	}
</style>
