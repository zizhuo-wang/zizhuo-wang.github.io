---
import BeyondResearch from './BeyondResearch.astro';

interface PortraitLink {
	label: string;
	href?: string;
	iconPaths?: readonly string[];
	iconText?: string;
}

const portraitLinks: PortraitLink[] = [
	{
		label: 'Google Scholar',
		iconPaths: [
			'M12 3 1 9l4 2.18v5.5L12 21l7-4.32v-5.5L21 10v7h2V9L12 3Zm5 12.55-5 3.03-5-3.03v-3.28l5 2.73 5-2.73v3.28Z',
		],
	},
	{
		label: 'CV',
		iconText: 'CV',
	},
	{
		label: 'GitHub',
		href: 'https://github.com/Wzz-D',
		iconPaths: [
			'M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.49 0-.24-.01-1.03-.01-1.87-2.78.6-3.37-1.18-3.37-1.18-.45-1.15-1.1-1.46-1.1-1.46-.9-.61.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.64.35-1.08.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.26-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.52 9.52 0 0 1 12 6.8c.85 0 1.71.11 2.5.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.39.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.69-4.57 4.94.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10 10 0 0 0 22 12c0-5.52-4.48-10-10-10Z',
		],
	},
	{
		label: 'WeChat',
		iconPaths: [
			'M8.5 4C4.9 4 2 6.3 2 9.2c0 1.7 1 3.2 2.6 4.2L4 16l2.7-1.3c.6.1 1.2.2 1.8.2 3.6 0 6.5-2.4 6.5-5.4S12.1 4 8.5 4Z',
			'M14.8 9.2c4 0 7.2 2.4 7.2 5.4 0 1.7-1 3.2-2.6 4.2L20 21l-2.8-1.3c-.8.2-1.6.3-2.4.3-3.7 0-6.7-2.1-7.2-4.8',
		],
	},
];
---

<!-- TODO: replace the portrait, biography, and placeholder profile links with verified content. -->
<section class="intro" id="about" aria-labelledby="intro-name">
	<div class="page-container intro-layout">
		<header class="intro-heading">
			<h1 id="intro-name">Zizhuo Wang</h1>
			<p class="research-role"><em>Robotics &amp; AI Researcher</em></p>
		</header>

		<aside class="intro-profile" aria-label="Profile and contact information">
			<div
				class="portrait-placeholder"
				role="img"
				aria-label="Portrait placeholder for Zizhuo Wang; replace with a real photograph"
			>
				<span>Portrait photo<br />to be added</span>
			</div>

			<div class="contact-panel">
				<h2>Contact</h2>
				<p class="student-title">Undergraduate Student</p>
				<p class="institution">Tsinghua University</p>
				<a href="mailto:wangzizhuo906@gmail.com">wangzizhuo906@gmail.com</a>
			</div>

			<nav class="portrait-links" aria-label="Academic and social profiles">
				<ul>
					{
						portraitLinks.map(({ label, href, iconPaths, iconText }) => (
							<li>
								{href ? (
									<a
										class="portrait-link"
										href={href}
										target="_blank"
										rel="noreferrer"
										aria-label={label}
									>
										{iconText ? (
											<span class="icon-text" aria-hidden="true">{iconText}</span>
										) : (
											<svg viewBox="0 0 24 24" aria-hidden="true">
												{iconPaths?.map((path) => <path d={path} />)}
											</svg>
										)}
									</a>
								) : (
									<span
										class="portrait-link is-disabled"
										aria-disabled="true"
										title={`${label} link forthcoming`}
									>
										{iconText ? (
											<span class="icon-text" aria-hidden="true">{iconText}</span>
										) : (
											<svg viewBox="0 0 24 24" aria-hidden="true">
												{iconPaths?.map((path) => <path d={path} />)}
											</svg>
										)}
										<span class="visually-hidden">{label} link forthcoming</span>
									</span>
								)}
							</li>
						))
					}
				</ul>
			</nav>
		</aside>

		<div class="intro-copy">
			<div class="biography">
				<p>
					I am a researcher working on robot learning and intelligent robotic systems. My
					research focuses on humanoid robotics, robot learning, loco-manipulation,
					tactile sensing, and dexterous interaction.
				</p>
				<p>
					My goal is to build robots that can robustly move, perceive, and physically
					interact with complex real-world environments.
				</p>
			</div>

			<div class="research-interests">
				<h2>Research Interests</h2>
				<ol>
					<li>Humanoid Robotics</li>
					<li>Robot Learning &amp; Loco-Manipulation</li>
					<li>Tactile Sensing &amp; Dexterous Interaction</li>
				</ol>
			</div>

			<BeyondResearch />
		</div>
	</div>
</section>

<style>
	.intro {
		padding-block: clamp(2.75rem, 6vw, 4.75rem) 0;
	}

	.intro-layout {
		display: grid;
		grid-template-areas:
			'heading'
			'profile'
			'copy';
		gap: 1.75rem;
		align-items: start;
	}

	.intro-heading {
		grid-area: heading;
	}

	.intro-heading h1 {
		position: relative;
		width: fit-content;
		margin: 0;
		font-size: clamp(2.1rem, 5vw, 2.65rem);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.1;
	}

	.intro-heading h1::after {
		display: block;
		width: 2.25rem;
		height: 2px;
		margin-top: 0.55rem;
		background: var(--color-link);
		content: '';
	}

	.research-role {
		margin: 0.6rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.96rem;
		font-weight: 450;
		line-height: 1.45;
	}

	.research-role em {
		font-style: italic;
	}

	.intro-profile {
		grid-area: profile;
		justify-self: center;
		width: min(13.5rem, 72vw);
	}

	.portrait-placeholder {
		display: grid;
		place-items: center;
		width: min(12.25rem, 100%);
		aspect-ratio: 1;
		margin-inline: auto;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		background: var(--color-placeholder);
		color: var(--color-text-muted);
		font-size: 0.78rem;
		line-height: 1.45;
		text-align: center;
	}

	.contact-panel {
		margin-top: 1rem;
		padding: 0.85rem 0.9rem 0.9rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface);
	}

	.contact-panel h2,
	.contact-panel p {
		margin: 0;
	}

	.contact-panel h2 {
		margin-bottom: 0.45rem;
		color: var(--color-text-muted);
		font-size: 0.68rem;
		font-weight: 750;
		letter-spacing: 0.1em;
		line-height: 1.3;
		text-transform: uppercase;
	}

	.student-title {
		font-size: 0.86rem;
		font-weight: 680;
		letter-spacing: -0.01em;
		line-height: 1.4;
	}

	.institution {
		margin-top: 0.12rem !important;
		font-size: 0.82rem;
		font-weight: 550;
		line-height: 1.4;
	}

	.contact-panel a {
		display: block;
		margin-top: 0.42rem;
		font-size: 0.76rem;
		font-weight: 500;
		letter-spacing: -0.015em;
		line-height: 1.4;
		overflow-wrap: anywhere;
		text-decoration: none;
	}

	.contact-panel a:hover,
	.contact-panel a:focus-visible {
		text-decoration: underline;
	}

	.portrait-links {
		margin-top: 0.8rem;
	}

	.portrait-links ul {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(0.9rem, 5vw, 1.25rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.portrait-link {
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		color: var(--color-link);
		text-decoration: none;
	}

	.portrait-link:not(.is-disabled):hover {
		color: var(--color-link-hover);
	}

	.portrait-link.is-disabled {
		color: var(--color-text-muted);
		cursor: default;
		opacity: 0.55;
	}

	.portrait-link svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: currentColor;
	}

	.icon-text {
		font-size: 0.88rem;
		font-weight: 750;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.intro-copy {
		grid-area: copy;
		max-width: 48rem;
	}

	.biography p,
	.research-interests h2 {
		margin: 0;
	}

	.biography p + p {
		margin-top: 0.85rem;
	}

	.research-interests {
		margin-top: 1.4rem;
		padding: 0.9rem 1rem;
		border-left: 3px solid var(--color-link);
		border-radius: 0 var(--radius-media) var(--radius-media) 0;
		background: var(--color-accent-soft);
		font-size: 0.94rem;
		line-height: 1.55;
	}

	.research-interests h2 {
		font-size: 0.94rem;
		font-weight: 700;
		line-height: 1.4;
	}

	.research-interests ol {
		display: grid;
		gap: 0.28rem;
		margin: 0.55rem 0 0;
		padding-left: 1.35rem;
		list-style: decimal;
	}

	.research-interests li {
		padding-left: 0.15rem;
	}

	@media (min-width: 40rem) {
		.intro-layout {
			grid-template-columns: 13.5rem minmax(0, 1fr);
			grid-template-areas:
				'profile heading'
				'profile copy';
			column-gap: clamp(2.25rem, 5vw, 4rem);
			row-gap: 1.25rem;
		}

		.intro-profile {
			justify-self: stretch;
			width: 100%;
		}
	}
</style>
