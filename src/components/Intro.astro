---
import BeyondResearch from './BeyondResearch.astro';

interface PortraitLink {
	label: string;
	iconPaths?: readonly string[];
	iconText?: string;
}

const portraitLinks: PortraitLink[] = [
	{
		label: 'Google Scholar',
		iconPaths: [
			'M12 3 1 9l4 2.18v5.5L12 21l7-4.32v-5.5L21 10v7h2V9L12 3Zm5 12.55-5 3.03-5-3.03v-3.28l5 2.73 5-2.73v3.28Z',
		],
	},
	{
		label: 'CV',
		iconText: 'CV',
	},
	{
		label: 'GitHub',
		iconPaths: [
			'M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.49 0-.24-.01-1.03-.01-1.87-2.78.6-3.37-1.18-3.37-1.18-.45-1.15-1.1-1.46-1.1-1.46-.9-.61.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.64.35-1.08.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.26-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.52 9.52 0 0 1 12 6.8c.85 0 1.71.11 2.5.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.39.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.69-4.57 4.94.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10 10 0 0 0 22 12c0-5.52-4.48-10-10-10Z',
		],
	},
	{
		label: 'WeChat',
		iconPaths: [
			'M8.5 4C4.9 4 2 6.3 2 9.2c0 1.7 1 3.2 2.6 4.2L4 16l2.7-1.3c.6.1 1.2.2 1.8.2 3.6 0 6.5-2.4 6.5-5.4S12.1 4 8.5 4Z',
			'M14.8 9.2c4 0 7.2 2.4 7.2 5.4 0 1.7-1 3.2-2.6 4.2L20 21l-2.8-1.3c-.8.2-1.6.3-2.4.3-3.7 0-6.7-2.1-7.2-4.8',
		],
	},
] as const;
---

<!-- TODO: replace with real content once the portrait, affiliation, biography, and profile links are provided. -->
<section class="intro" id="about" aria-labelledby="intro-name">
	<div class="page-container intro-layout">
		<div class="intro-profile">
			<div
				class="portrait-placeholder"
				role="img"
				aria-label="Portrait placeholder for Zizhuo Wang; replace with a real photograph"
			>
				<span>Portrait photo<br />to be added</span>
			</div>

			<div class="profile-details">
				<p class="student-title">Undergraduate Student</p>
				<p class="institution">Tsinghua University</p>
				<a href="mailto:wangzizhuo906@gmail.com">wangzizhuo906@gmail.com</a>
			</div>

			<div class="portrait-links" aria-label="Contact and profile links forthcoming">
				<ul>
					{portraitLinks.map(({ label, iconPaths, iconText }) => (
						<li>
							<span class="portrait-link" aria-disabled="true">
								{iconText ? (
									<span class="icon-text" aria-hidden="true">{iconText}</span>
								) : (
									<svg viewBox="0 0 24 24" aria-hidden="true">
										{iconPaths?.map((path) => <path d={path} />)}
									</svg>
								)}
								<span class="visually-hidden">{label} link forthcoming</span>
							</span>
						</li>
					))}
				</ul>
			</div>
		</div>

		<div class="intro-copy">
			<h1 id="intro-name">Zizhuo Wang</h1>
			<p class="research-role"><em>Robotics &amp; AI Researcher</em></p>

			<div class="biography">
				<p>
					I am a researcher working on robot learning and intelligent robotic systems. My
					research focuses on humanoid robotics, robot learning, loco-manipulation,
					tactile sensing, and dexterous interaction.
				</p>
				<p>
					My goal is to build robots that can robustly move, perceive, and physically
					interact with complex real-world environments.
				</p>
			</div>

			<p class="research-interests">
				<strong>Research interests:</strong>{' '}
				Humanoid Robotics · Robot Learning · Loco-Manipulation · Tactile Sensing ·
				Dexterous Interaction
			</p>

			<BeyondResearch />
		</div>
	</div>
</section>

<style>
	.intro {
		padding-block: clamp(2.5rem, 6vw, 4.25rem) 1rem;
	}

	.intro-layout {
		display: grid;
		gap: 1.75rem;
		align-items: start;
	}

	.intro-profile {
		width: min(11.25rem, 55vw);
	}

	.portrait-placeholder {
		display: grid;
		place-items: center;
		width: 100%;
		aspect-ratio: 4 / 5;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-media);
		background: var(--color-placeholder);
		color: var(--color-text-muted);
		font-size: 0.8rem;
		line-height: 1.45;
		text-align: center;
	}

	.intro-copy {
		max-width: 44rem;
	}

	.intro-copy h1 {
		margin: 0;
		font-size: clamp(1.95rem, 4.5vw, 2.35rem);
		font-weight: 680;
		letter-spacing: -0.025em;
		line-height: 1.15;
	}

	.research-role {
		margin: 0.35rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.95rem;
		font-weight: 450;
	}

	.research-role em {
		font-style: italic;
	}

	.biography {
		margin-top: 1.3rem;
	}

	.biography p,
	.research-interests {
		margin: 0;
	}

	.biography p + p {
		margin-top: 0.75rem;
	}

	.research-interests {
		margin-top: 1.15rem;
	}

	.research-interests strong {
		font-weight: 650;
	}

	.profile-details {
		margin-top: 0.85rem;
		text-align: center;
	}

	.profile-details p,
	.profile-details a {
		display: block;
		margin: 0;
	}

	.profile-details .student-title {
		font-size: 0.88rem;
		font-weight: 680;
		letter-spacing: -0.01em;
		line-height: 1.4;
	}

	.profile-details .institution {
		margin-top: 0.12rem;
		color: var(--color-text);
		font-size: 0.82rem;
		font-weight: 550;
		letter-spacing: 0.005em;
		line-height: 1.4;
	}

	.profile-details a {
		margin-top: 0.3rem;
		color: var(--color-text-muted);
		font-size: 0.76rem;
		font-weight: 500;
		letter-spacing: -0.018em;
		line-height: 1.4;
		text-decoration: none;
	}

	.profile-details a:hover,
	.profile-details a:focus-visible {
		color: var(--color-link);
		text-decoration: underline;
	}

	.portrait-links {
		margin-top: 0.75rem;
	}

	.portrait-links ul {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
		margin: 0;
		padding: 0.15rem 0.2rem;
		list-style: none;
	}

	.portrait-link {
		display: grid;
		place-items: center;
		width: 1.6rem;
		height: 1.6rem;
		color: var(--color-link);
	}

	.portrait-link svg {
		width: 1.3rem;
		height: 1.3rem;
		fill: currentColor;
	}

	.icon-text {
		font-size: 0.9rem;
		font-weight: 750;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	@media (min-width: 40rem) {
		.intro-layout {
			grid-template-columns: 12.5rem minmax(0, 1fr);
			gap: clamp(2rem, 5vw, 3rem);
		}

		.intro-profile {
			width: 12.5rem;
		}
	}
</style>
