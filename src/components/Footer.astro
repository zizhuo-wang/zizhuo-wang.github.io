---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="page-container footer-inner">
		<p>&copy; {currentYear} Zizhuo Wang</p>
		<!-- TODO: replace with real content when a meaningful last-updated date is available. -->
		<p>Last updated: placeholder</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		padding-block: 1.6rem;
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.35rem 1.5rem;
	}

	p {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.78rem;
	}
</style>
