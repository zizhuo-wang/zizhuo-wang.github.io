---
import BeyondResearch from './BeyondResearch.astro';

const portraitSrc = `${import.meta.env.BASE_URL}images/zizhuo-wang-portrait.jpg`;

interface PortraitLink {
	label: string;
	href?: string;
	iconPaths?: readonly string[];
	iconText?: string;
}

const portraitLinks: PortraitLink[] = [
	{
		label: 'Google Scholar',
		href: 'https://scholar.google.com/citations?user=X0j3N78AAAAJ',
		iconPaths: [
			'M12 3 1 9l4 2.18v5.5L12 21l7-4.32v-5.5L21 10v7h2V9L12 3Zm5 12.55-5 3.03-5-3.03v-3.28l5 2.73 5-2.73v3.28Z',
		],
	},
	{
		label: 'CV',
		iconText: 'CV',
	},
	{
		label: 'GitHub',
		href: 'https://github.com/Wzz-D',
		iconPaths: [
			'M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.49 0-.24-.01-1.03-.01-1.87-2.78.6-3.37-1.18-3.37-1.18-.45-1.15-1.1-1.46-1.1-1.46-.9-.61.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.64.35-1.08.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.26-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.52 9.52 0 0 1 12 6.8c.85 0 1.71.11 2.5.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.39.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.69-4.57 4.94.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10 10 0 0 0 22 12c0-5.52-4.48-10-10-10Z',
		],
	},
	{
		label: 'X',
		href: 'https://x.com/wangzizhuo_',
		iconPaths: [
			'M18.244 2H21.5l-7.12 8.14L22.75 22H16.2l-5.13-6.72L5.19 22H1.93l7.62-8.72L1.5 2h6.72l4.64 6.13L18.244 2Zm-1.15 18h1.8L7.19 3.89H5.26L17.09 20Z',
		],
	},
];
---

<!-- TODO: replace the portrait, biography, and placeholder profile links with verified content. -->
<section class="intro" id="about" aria-labelledby="intro-name">
	<div class="page-container intro-layout">
		<header class="intro-heading">
			<h1 id="intro-name">
				Zizhuo Wang<span class="chinese-name" lang="zh-Hans">王子卓</span>
			</h1>
			<p class="research-role"><em>Robotics &amp; Embodied AI Researcher</em></p>
		</header>

		<aside class="intro-profile" aria-label="Profile and contact information">
			<img
				class="portrait-image"
				src={portraitSrc}
				alt="Portrait of Zizhuo Wang by the sea"
				width="1279"
				height="1355"
				decoding="async"
				fetchpriority="high"
			/>

			<div class="profile-identity">
				<p class="student-title">Undergraduate Student</p>
				<p class="institution">Tsinghua University</p>
				<p class="study-years">2023–2027</p>
			</div>

			<address class="profile-contact" aria-label="Contact">
				<a class="email-link" href="mailto:wang-zz23@tsinghua.edu.cn">
					<svg
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<rect x="3" y="5" width="18" height="14" rx="2" />
						<path d="m4 7 8 6 8-6" />
					</svg>
					<span>wang-zz23@tsinghua.edu.cn</span>
				</a>
			</address>

			<nav class="portrait-links" aria-label="Academic and social profiles">
				<ul>
					{
						portraitLinks.map(({ label, href, iconPaths, iconText }) => (
							<li>
								{href ? (
									<a
										class="portrait-link"
										href={href}
										target="_blank"
										rel="noreferrer"
										aria-label={label}
									>
										{iconText ? (
											<span class="icon-text" aria-hidden="true">{iconText}</span>
										) : (
											<svg viewBox="0 0 24 24" aria-hidden="true">
												{iconPaths?.map((path) => <path d={path} />)}
											</svg>
										)}
									</a>
								) : (
									<span
										class="portrait-link is-disabled"
										aria-disabled="true"
										title={`${label} link forthcoming`}
									>
										{iconText ? (
											<span class="icon-text" aria-hidden="true">{iconText}</span>
										) : (
											<svg viewBox="0 0 24 24" aria-hidden="true">
												{iconPaths?.map((path) => <path d={path} />)}
											</svg>
										)}
										<span class="visually-hidden">{label} link forthcoming</span>
									</span>
								)}
							</li>
						))
					}
				</ul>
			</nav>
		</aside>

		<div class="intro-copy">
			<div class="biography">
				<p>
					I am currently an undergraduate student in Weiyang College, Tsinghua University.
				</p>
				<p>
					I am currently seeking a PhD position starting in 2027 Fall, and am happy to discuss potential opportunities.
				</p>
			</div>

			<div class="research-interests">
				<h2>Research Interests</h2>
				<ol>
					<li>Humanoid Robotics</li>
					<li>Robot Learning &amp; Loco-Manipulation</li>
					<li>Tactile Sensing &amp; Dexterous Interaction</li>
				</ol>
			</div>

			<BeyondResearch />
		</div>
	</div>
</section>

<style>
	.intro {
		padding-block: clamp(2.75rem, 6vw, 4.75rem) 0;
	}

	.intro-layout {
		display: grid;
		grid-template-areas:
			'heading'
			'profile'
			'copy';
		gap: 1.75rem;
		align-items: start;
	}

	.intro-heading {
		grid-area: heading;
	}

	.intro-heading h1 {
		position: relative;
		width: fit-content;
		margin: 0;
		font-size: clamp(2.1rem, 5vw, 2.65rem);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.1;
	}

	.intro-heading h1::after {
		display: block;
		width: 2.25rem;
		height: 2px;
		margin-top: 0.55rem;
		background: var(--color-link);
		content: '';
	}

	.research-role {
		margin: 0.6rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.96rem;
		font-weight: 450;
		line-height: 1.45;
	}

	.research-role em {
		font-style: italic;
	}

	.intro-profile {
		grid-area: profile;
		justify-self: center;
		width: min(14rem, 76vw);
	}

	.portrait-image {
		display: block;
		width: min(14rem, 100%);
		height: auto;
		margin-inline: auto;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-media);
		background: var(--color-placeholder);
		object-fit: cover;
		object-position: center;
	}

	.profile-identity {
		display: grid;
		justify-items: center;
		width: 100%;
		margin-top: 0.9rem;
		text-align: center;
	}

	.profile-identity p {
		margin: 0;
	}

	.student-title {
		font-size: 0.9rem;
		font-weight: 680;
		letter-spacing: -0.01em;
		line-height: 1.4;
	}

	.institution {
		margin-top: 0.12rem !important;
		font-size: 0.84rem;
		font-weight: 550;
		line-height: 1.4;
	}

	.study-years {
		margin-top: 0.2rem !important;
		color: #6c706a;
		font-size: 0.72rem;
		font-weight: 400;
		font-variant-numeric: lining-nums tabular-nums;
		letter-spacing: 0.06em;
		line-height: 1.4;
	}

	.profile-contact {
		margin-top: 1rem;
		font-style: normal;
	}

	.chinese-name {
		display: inline-block;
		margin-left: 0.28em;
		color: var(--color-text-muted);
		font-size: 0.66em;
		font-weight: 500;
		letter-spacing: 0.015em;
		vertical-align: 0.08em;
		white-space: nowrap;
	}

	.email-link {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		width: fit-content;
		max-width: 100%;
		min-height: 34px;
		margin-inline: auto;
		padding: 0.375rem 0.625rem;
		border: 1px solid #d3dde5;
		border-radius: 8px;
		background: #eef2f4;
		color: #4c6275;
		font-size: 0.78rem;
		font-weight: 400;
		line-height: 1.4;
		text-decoration: none;
	}

	.email-link svg {
		flex: none;
		width: 16px;
		height: 16px;
	}

	.email-link span {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.email-link:hover,
	.email-link:focus-visible,
	.portrait-link:not(.is-disabled):hover,
	.portrait-link:not(.is-disabled):focus-visible {
		border-color: var(--color-link);
		background: var(--color-accent-soft);
		color: var(--color-link);
	}

	.portrait-links {
		margin-top: 0.8rem;
	}

	.portrait-links ul {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.portrait-link {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		background: var(--color-surface);
		color: var(--color-text-muted);
		text-decoration: none;
	}

	.portrait-link.is-disabled {
		color: var(--color-text-muted);
		cursor: default;
		opacity: 0.55;
	}

	.portrait-link svg {
		width: 16px;
		height: 16px;
		fill: currentColor;
	}

	.icon-text {
		font-size: 0.75rem;
		font-weight: 750;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.intro-copy {
		grid-area: copy;
		max-width: 48rem;
	}

	.biography p,
	.research-interests h2 {
		margin: 0;
	}

	.biography p + p {
		margin-top: 0.85rem;
	}

	.research-interests {
		margin-top: 1.4rem;
		padding: 0.9rem 1rem;
		border-left: 3px solid var(--color-link);
		border-radius: 0 var(--radius-media) var(--radius-media) 0;
		background: var(--color-interest-background);
		font-size: 1rem;
		line-height: 1.55;
	}

	.research-interests h2 {
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.4;
	}

	.research-interests ol {
		display: grid;
		gap: 0.28rem;
		margin: 0.55rem 0 0;
		padding-left: 1.35rem;
		list-style: decimal;
	}

	.research-interests li {
		padding-left: 0.15rem;
	}

	@media (min-width: 40rem) {
		.intro-layout {
			grid-template-columns: 14rem minmax(0, 1fr);
			grid-template-areas:
				'profile heading'
				'profile copy';
			grid-template-rows: auto 1fr;
			column-gap: clamp(2.25rem, 5vw, 4rem);
			row-gap: 1.25rem;
		}

		.intro-profile {
			justify-self: stretch;
			width: 100%;
		}
	}
</style>
