---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;
const publicationLine = [project.venue, project.year].filter(Boolean).join(' ');
const mediaAspectRatio =
	project.media.width && project.media.height
		? project.media.width / project.media.height
		: (project.media.aspectRatio ?? 16 / 9);
---

<article class="project-item" data-placeholder={project.placeholder ? 'true' : undefined}>
	<div class="media-frame" style={{ '--media-aspect-ratio': mediaAspectRatio }}>
		{
			project.media.type === 'video' && project.media.src ? (
				<video
					class:list={['project-media', { 'is-contain': project.media.fit === 'contain' }]}
					src={project.media.src}
					width={project.media.width}
					height={project.media.height}
					poster={project.media.poster}
					aria-label={project.media.alt}
					data-project-video
					muted
					loop
					playsinline
					preload="metadata"
					controls
				/>
			) : project.media.type === 'image' && project.media.src ? (
				<img
					class:list={['project-media', { 'is-contain': project.media.fit === 'contain' }]}
					src={project.media.src}
					width={project.media.width}
					height={project.media.height}
					alt={project.media.alt}
					loading="lazy"
				/>
			) : (
				<div class="project-media media-placeholder" role="img" aria-label={project.media.alt}>
					<span>Project media placeholder</span>
				</div>
			)
		}
	</div>

	<div class="project-content">
		<h3>{project.title}</h3>

		<p class="authors">
			{
				project.authors.map((author, index) => (
					<span>
						<span class:list={{ 'site-author': author.isSiteOwner }}>{author.name}</span>
						{author.equalContribution && (
							<sup class="equal-contribution-marker">
								<span aria-hidden="true">*</span>
								<span class="visually-hidden"> (equal contribution)</span>
							</sup>
						)}
						{index < project.authors.length - 1 ? ', ' : ''}
					</span>
				))
			}
		</p>

		{
			(publicationLine || project.publicationStatus || project.awards?.length) && (
				<div class="publication-labels" aria-label="Publication details">
					{publicationLine && <span class="venue-label">{publicationLine}</span>}
					{project.publicationStatus && (
						<span class="status-label">{project.publicationStatus}</span>
					)}
					{project.awards?.map((award) => (
						<span class:list={['award-label', { 'is-spotlight': award.startsWith('Spotlight') }]}>
							{award}
						</span>
					))}
				</div>
			)
		}

		<p class="description">{project.description}</p>

		<div class="item-links" aria-label={`Links for ${project.title}`}>
			{
				project.links.map((link) =>
					link.href ? (
						<a href={link.href} target="_blank" rel="noopener noreferrer">
							{link.label}<span class="visually-hidden"> (opens in a new tab)</span>
						</a>
					) : (
						<span aria-disabled="true">
							{link.label}<span class="visually-hidden"> link forthcoming</span>
						</span>
					),
				)
			}
		</div>
	</div>
</article>

<script>
	const projectVideos = Array.from(
		document.querySelectorAll<HTMLVideoElement>('[data-project-video]'),
	);
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const visibleVideos = new Set<HTMLVideoElement>();

	const syncVideo = (video: HTMLVideoElement) => {
		if (reducedMotion.matches || document.hidden || !visibleVideos.has(video)) {
			video.pause();
			return;
		}

		video.muted = true;
		void video.play().catch(() => {
			// Browsers may still require explicit interaction; native controls remain available.
		});
	};

	if ('IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const video = entry.target as HTMLVideoElement;
					if (entry.isIntersecting && entry.intersectionRatio >= 0.35) {
						visibleVideos.add(video);
					} else {
						visibleVideos.delete(video);
					}
					syncVideo(video);
				}
			},
			{ threshold: [0, 0.35] },
		);

		projectVideos.forEach((video) => observer.observe(video));
	}

	reducedMotion.addEventListener('change', () => projectVideos.forEach(syncVideo));
	document.addEventListener('visibilitychange', () => projectVideos.forEach(syncVideo));
</script>

<style>
	.project-item {
		display: grid;
		gap: 1.15rem;
		padding: 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface);
	}

	.media-frame {
		min-width: 0;
		align-self: start;
		overflow: hidden;
		border-radius: var(--radius-media);
		background: var(--color-placeholder);
	}

	.project-media {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: auto var(--media-aspect-ratio);
		background: var(--color-placeholder);
		object-fit: cover;
	}

	.project-media.is-contain {
		object-fit: contain;
	}

	.media-placeholder {
		aspect-ratio: var(--media-aspect-ratio);
		display: grid;
		place-items: center;
		color: var(--color-text-muted);
		font-size: 0.78rem;
		text-align: center;
	}

	.project-content {
		padding: 0 0.25rem 0.2rem;
	}

	.project-content h3,
	.project-content p {
		margin: 0;
	}

	.project-content h3 {
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.012em;
		line-height: 1.35;
	}

	.authors {
		margin-top: 0.28rem !important;
		font-size: 0.86rem;
		line-height: 1.45;
	}

	.site-author {
		font-weight: 720;
		text-decoration-line: underline;
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.16em;
	}

	.equal-contribution-marker {
		margin-left: 0.08em;
		color: var(--color-text-muted);
		font-size: 0.9em;
		line-height: 0;
	}

	.publication-labels {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.28rem 0.4rem;
		margin-top: 0.42rem;
	}

	.venue-label,
	.status-label,
	.award-label {
		display: inline-flex;
		align-items: center;
		min-height: 1.45rem;
		padding: 0.12rem 0.48rem;
		border-radius: 0.35rem;
		font-size: 0.72rem;
		font-weight: 680;
		line-height: 1.25;
	}

	.venue-label,
	.status-label {
		background: var(--color-accent-soft);
		color: var(--color-link-hover);
	}

	.status-label {
		border: 1px solid #d4e1ec;
		background: transparent;
	}

	.award-label {
		background: var(--color-award-soft);
		color: var(--color-award);
	}

	.award-label.is-spotlight {
		background: #fff0ee;
		color: #b4232d;
	}

	.description {
		margin-top: 0.48rem !important;
		color: var(--color-text-muted);
		font-size: 0.86rem;
		font-style: italic;
		line-height: 1.5;
	}

	.item-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.45rem;
		margin-top: 0.62rem;
		font-size: 0.76rem;
	}

	.item-links a,
	.item-links span[aria-disabled='true'] {
		display: inline-flex;
		align-items: center;
		min-height: 1.65rem;
		padding: 0.15rem 0.55rem;
		border: 1px solid var(--color-border-strong);
		border-radius: 0.3rem;
		font-weight: 620;
		line-height: 1.25;
		text-decoration: none;
	}

	.item-links a {
		background: var(--color-surface);
		color: var(--color-link);
	}

	.item-links a:hover,
	.item-links a:focus-visible {
		border-color: var(--color-link);
		color: var(--color-link-hover);
	}

	.item-links span[aria-disabled='true'] {
		color: var(--color-text-muted);
		opacity: 0.68;
	}

	@media (min-width: 40rem) {
		.project-item {
			grid-template-columns: clamp(13.75rem, 24vw, 17.5rem) minmax(0, 1fr);
			gap: clamp(1.35rem, 3vw, 2.25rem);
			padding: 0.85rem;
		}

		.project-content {
			align-self: center;
			padding: 0.1rem 0.5rem 0.15rem 0;
		}
	}
</style>
