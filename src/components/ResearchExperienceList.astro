---
import type { ResearchExperienceItem } from '../data/researchExperience';
import ExperienceItem from './ExperienceItem.astro';

interface Props {
	items: ResearchExperienceItem[];
}

const { items } = Astro.props;
---

<section
	class="research-experience"
	id="research-experience"
	aria-labelledby="research-experience-heading"
>
	<div class="page-container">
		<h2 id="research-experience-heading">Research Experience</h2>
		<ol class="experience-list">
			{items.map((item) => <ExperienceItem item={item} />)}
		</ol>
	</div>
</section>

<style>
	.research-experience {
		padding-block: clamp(1.5rem, 3vw, 2.5rem) var(--section-space);
	}

	h2 {
		position: relative;
		width: fit-content;
		margin: 0 0 1.75rem;
		font-size: var(--font-size-section-title);
		font-weight: 680;
		line-height: 1.25;
	}

	h2::after {
		display: block;
		width: 2rem;
		height: 2px;
		margin-top: 0.45rem;
		background: var(--color-link);
		content: '';
	}

	.experience-list {
		display: grid;
		gap: 1.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
