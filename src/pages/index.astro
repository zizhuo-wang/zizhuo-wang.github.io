---
import ExperienceList from '../components/ExperienceList.astro';
import Intro from '../components/Intro.astro';
import ProjectItem from '../components/ProjectItem.astro';
import { experienceItems } from '../data/experience';
import { projects } from '../data/projects';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<Intro />

	<section class="research-section" id="research" aria-labelledby="research-heading">
		<div class="page-container">
			<header class="section-header">
				<h2 id="research-heading">Selected Research</h2>
			</header>

			<div class="academic-list">
				{projects.map((project) => <ProjectItem project={project} />)}
			</div>
		</div>
	</section>

	<ExperienceList items={experienceItems} />
</BaseLayout>

<style>
	.research-section {
		padding-block: clamp(3.5rem, 7vw, 6rem);
	}

	.section-header {
		margin-bottom: 1.35rem;
	}

	.section-header h2 {
		position: relative;
		width: fit-content;
		margin: 0;
		font-size: var(--font-size-section-title);
		font-weight: 680;
		line-height: 1.25;
	}

	.section-header h2::after {
		display: block;
		width: 2rem;
		height: 2px;
		margin-top: 0.45rem;
		background: var(--color-link);
		content: '';
	}

	.academic-list {
		display: grid;
		gap: 0.9rem;
	}
</style>
