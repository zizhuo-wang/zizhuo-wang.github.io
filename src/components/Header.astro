---
const homeHref = import.meta.env.BASE_URL;

const navigation = [
	{ label: 'Home', href: `${homeHref}#top` },
	{ label: 'Research', href: `${homeHref}#research` },
	{
		label: 'Publications',
		href: `${homeHref}#research`,
		ariaLabel: 'Publications within Selected Research',
	},
	{ label: 'About', href: `${homeHref}#about` },
];
---

<header class="site-header" id="top">
	<div class="page-container header-inner">
		<a class="site-name" href={homeHref} aria-label="Zizhuo Wang, home">Zizhuo Wang</a>

		<nav class="primary-navigation" aria-label="Primary navigation">
			<ul>
				{
					navigation.map((item) => (
						<li>
							<a href={item.href} aria-label={item.ariaLabel}>{item.label}</a>
						</li>
					))
				}
				<li>
					<span class="pending-link" aria-disabled="true">
						CV<span class="visually-hidden"> (forthcoming)</span>
					</span>
				</li>
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--color-border);
		background: var(--color-background);
	}

	.header-inner {
		display: grid;
		gap: 0.75rem;
		padding-block: 0.9rem;
	}

	.site-name {
		flex: none;
		width: fit-content;
		color: var(--color-text);
		font-size: 1rem;
		font-weight: 680;
		text-decoration: none;
		white-space: nowrap;
	}

	.primary-navigation {
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.primary-navigation::-webkit-scrollbar {
		display: none;
	}

	.primary-navigation ul {
		display: flex;
		justify-content: space-between;
		gap: 0.9rem;
		width: max-content;
		min-width: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.primary-navigation a,
	.pending-link {
		font-size: 0.875rem;
		line-height: 1.4;
		white-space: nowrap;
	}

	.primary-navigation a {
		color: var(--color-text);
		text-decoration: none;
	}

	.primary-navigation a:hover,
	.primary-navigation a:focus-visible {
		color: var(--color-link);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
	}

	.pending-link {
		color: var(--color-text-muted);
		cursor: default;
	}

	@media (min-width: 40rem) {
		.header-inner {
			display: flex;
			align-items: center;
			justify-content: space-between;
			min-height: 3.75rem;
			padding-block: 0.75rem;
		}

		.primary-navigation {
			overflow: visible;
		}

		.primary-navigation ul {
			gap: clamp(1.15rem, 2.5vw, 1.8rem);
			min-width: 0;
		}
	}
</style>
